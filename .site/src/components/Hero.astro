---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import fabric from '../../public/images/fabric-hero.svg?raw';

const isHome = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
---

{isHome ? (
  <div class="rfl-hero-grid">
    <DefaultHero />
    <div class="rfl-fabric" data-motion="paused">
      <div aria-hidden="true" set:html={fabric} />
      <button class="rfl-fabric-toggle" type="button" aria-label="Pause animation" hidden>
        <svg class="pause-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" /></svg>
        <svg class="play-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m5 3 8 5-8 5z" /></svg>
      </button>
    </div>
  </div>
) : <DefaultHero />}

<script>
  for (const art of document.querySelectorAll<HTMLElement>('.rfl-fabric')) {
    const button = art.querySelector<HTMLButtonElement>('button');
    if (!button) continue;
    let visible = false;
    let paused = false;
    const update = () => {
      art.dataset.motion = visible && !document.hidden && !paused ? 'running' : 'paused';
    };
    new IntersectionObserver(([entry]) => {
      if (!entry) return;
      visible = entry.isIntersecting;
      update();
    }).observe(art);
    document.addEventListener('visibilitychange', update);
    button.hidden = false;
    button.addEventListener('click', () => {
      paused = !paused;
      button.dataset.paused = String(paused);
      button.setAttribute('aria-label', paused ? 'Resume animation' : 'Pause animation');
      update();
    });
  }
</script>

<style>
  .rfl-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    padding-block: 3rem 1.5rem;
  }
  .rfl-hero-grid :global(.hero) {
    display: flex;
    flex-direction: column;
    padding: 0;
  }
  .rfl-fabric { position: relative; width: min(100%, 19rem); margin-inline: auto; }
  .rfl-fabric :global(svg[role="img"]) { display: block; width: 100%; height: auto; }
  .rfl-fabric-toggle {
    position: absolute;
    right: 0;
    bottom: 0;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: .65rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 6px;
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-3);
    cursor: pointer;
    line-height: 0;
  }
  .rfl-fabric-toggle:hover { color: var(--sl-color-white); border-color: var(--sl-color-gray-3); }
  .rfl-fabric-toggle:focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .play-icon, [data-paused="true"] .pause-icon { display: none; }
  [data-paused="true"] .play-icon { display: inline; }
  @media (min-width: 50rem) {
    .rfl-hero-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 3%; }
    .rfl-fabric { width: min(100%, 28rem); }
  }
  @media (prefers-reduced-motion: reduce) { .rfl-fabric-toggle { display: none; } }
</style>
