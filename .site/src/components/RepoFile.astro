---
// A file of the repository as it is at build time, so the page cannot drift from it.
import { Code } from '@astrojs/starlight/components';
import { readFileSync } from 'node:fs';
import path from 'node:path';

interface Props {
  path: string;
  lang?: string;
}

const { path: file, lang = 'text' } = Astro.props;
const root = process.env.RFL_REPO_ROOT;
if (!root) throw new Error('RepoFile: RFL_REPO_ROOT is unset. astro.config.mjs sets it');
const code = readFileSync(path.join(root, file), 'utf8').replace(/\s+$/, '');
---

<Code code={code} lang={lang} title={file} />
