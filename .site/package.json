    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "6.4.8",
    "astro-mermaid": "2.0.4",
    "katex": "0.17.0",
    "mermaid": "11.15.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "starlight-github-alerts": "0.3.0",
    "starlight-image-zoom": "0.14.2",
    "starlight-links-validator": "0.24.1",
    "starlight-sidebar-topics": "0.8.0",
    "yaml": "2.9.1"
