# Rendered by ansible/playbooks/netbox-guest.yml. The docker-compose.yml of netbox-docker {{ netbox_lock['netbox.netbox_docker'].value }}
# with every image pinned by digest from versions.lock.yaml, NetBox built on its locked image with the topology views
# plugin, restart after a reboot, and NetBox published on port 8080 of this guest only. The harness forwards that port to
# 127.0.0.1 on the host.
name: rfl-netbox
services:
  netbox: &netbox
    image: {{ netbox_plugin_image }}
    pull_policy: never
    depends_on:
      - postgres
      - redis
      - redis-cache
    env_file: netbox.env
    user: "netbox:root"
    ports:
      - "8080:8080"
    restart: unless-stopped
    # The first start migrates the whole schema, which took more than 2 minutes on 4 vCPUs. Failures inside start_period
    # do not count, so it is long enough for that.
    healthcheck:
      test: /opt/netbox/health.sh
      start_period: 600s
      timeout: 3s
      interval: 15s
    volumes:
      - netbox-media-files:/opt/netbox/netbox/media:rw
  netbox-worker:
    <<: *netbox
    ports: []
    depends_on:
      netbox:
        condition: service_healthy
    command:
      - /opt/netbox/venv/bin/python
      - /opt/netbox/netbox/manage.py
      - rqworker
    healthcheck:
      test: ps -aux | grep -v grep | grep -q rqworker || exit 1
      start_period: 20s
      timeout: 3s
      interval: 15s
  postgres:
    image: {{ netbox_lock['netbox.postgres_image'].ref }}@{{ netbox_lock['netbox.postgres_image'].value }}
    restart: unless-stopped
    healthcheck:
      test: pg_isready -q -t 2 -d $$POSTGRES_DB -U $$POSTGRES_USER
      start_period: 20s
      timeout: 30s
      interval: 10s
      retries: 5
    env_file: postgres.env
    volumes:
      - netbox-postgres:/var/lib/postgresql
  redis:
    image: {{ netbox_lock['netbox.valkey_image'].ref }}@{{ netbox_lock['netbox.valkey_image'].value }}
    restart: unless-stopped
    command:
      - sh
      - -c
      - valkey-server --appendonly yes --requirepass $$REDIS_PASSWORD
    env_file: redis.env
    volumes:
      - netbox-redis-data:/data
  redis-cache:
    image: {{ netbox_lock['netbox.valkey_image'].ref }}@{{ netbox_lock['netbox.valkey_image'].value }}
    restart: unless-stopped
    command:
      - sh
      - -c
      - valkey-server --requirepass $$REDIS_PASSWORD
    env_file: redis-cache.env
    volumes:
      - netbox-redis-cache-data:/data
volumes:
  netbox-media-files:
  netbox-postgres:
  netbox-redis-data:
  netbox-redis-cache-data:
