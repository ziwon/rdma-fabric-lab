{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest.schema.json",
  "title": "Run manifest",
  "description": "manifest.json in results/<run-id>/<track>/<scenario>/. The status field is derived from checks and is never set by hand.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "track", "scenario", "description", "required", "result_kind",
    "status", "created_at", "finished_at", "repo", "environment", "inputs", "commands_log",
    "checks", "timing", "security"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "track": {"$ref": "#/$defs/slug"},
    "scenario": {"$ref": "#/$defs/slug"},
    "description": {"type": "string", "minLength": 1},
    "required": {"type": "boolean"},
    "result_kind": {
      "enum": ["software-rdma-measurement", "software-cluster-test", "ib-management-simulation", "packet-model-simulation"]
    },
    "status": {"$ref": "#/$defs/status"},
    "created_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": ["boolean", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host"],
      "properties": {
        "host": {"$ref": "#/$defs/machine"},
        "guests": {"type": "array", "items": {"$ref": "#/$defs/machine"}},
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "digest"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        },
        "tools": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "seed", "parameters"],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "seed": {"type": ["integer", "null"]},
        "parameters": {"type": "object"}
      }
    },
    "commands_log": {"const": "commands.log"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status", "exit_code", "failure_class", "evidence", "detail"],
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "description": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/status"},
          "exit_code": {"type": ["integer", "null"]},
          "failure_class": {
            "enum": [
              null, "timeout", "command-failed", "assertion-failed", "environment-blocked",
              "unsupported-on-tested-stack", "not-attempted"
            ]
          },
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "detail": {"type": ["string", "null"]}
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_seconds", "simulated_seconds"],
      "properties": {
        "wall_clock_seconds": {"type": ["number", "null"], "minimum": 0},
        "simulated_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privileged", "device_exposure"],
      "properties": {
        "privileged": {"type": "boolean"},
        "device_exposure": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["passed", "failed", "blocked", "not_run"]},
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "kernel"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "kernel": {"type": "string", "minLength": 1}
      }
    }
  }
}
